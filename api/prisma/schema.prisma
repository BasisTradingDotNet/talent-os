// talent-os — schema of record. Multi-org: every tenant-owned row carries orgId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String
  createdAt  DateTime      @default(now())
  jobs       Job[]
  kits       Kit[]
  candidates Candidate[]
  apps       Application[]
  sessions   Session[]
  segments   RecordingSegment[]
}

model Job {
  id        String        @id @default(cuid())
  orgId     String
  org       Organization  @relation(fields: [orgId], references: [id])
  title     String
  location  String?
  createdAt DateTime      @default(now())
  kits      Kit[]
  apps      Application[]

  @@index([orgId])
}

model Kit {
  id                    String       @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id])
  jobId                 String
  job                   Job          @relation(fields: [jobId], references: [id])
  slug                  String
  version               String
  title                 String
  candidateInstructions String
  /// DimensionDef[]
  dimensions            Json
  /// SectionSeed[] (bands included; edited in-app)
  sections              Json
  createdAt             DateTime     @default(now())
  questions             Question[]
  sessions              Session[]

  @@unique([orgId, slug, version])
}

model Question {
  id                String  @id @default(cuid())
  kitId             String
  kit               Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  key               String
  section           String
  stage             Int
  number            Int
  title             String
  domain            String
  difficulty        String?
  mode              String
  timeMinutes       Int?
  prompt            String
  dataset           Json?
  code              Json?
  modelAnswer       String?
  rubric            Json?
  trapOrBonus       String?
  whatGoodLooksLike String?
  /// v1.2: MarketConfig for mode "market". NEVER sent to candidates.
  market            Json?

  @@unique([kitId, key])
  @@index([kitId, section, number])
}

model Candidate {
  id              String        @id @default(cuid())
  orgId           String
  org             Organization  @relation(fields: [orgId], references: [id])
  name            String
  email           String?
  source          String?
  notes           String?
  overallDecision String?
  level           String?
  compNote        String?
  /// v1: when overallDecision was last set; starts the recording retention clock.
  decisionAt      DateTime?
  createdAt       DateTime      @default(now())
  apps            Application[]

  @@index([orgId, createdAt])
}

model Application {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  candidateId String
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id])
  createdAt   DateTime     @default(now())
  sessions    Session[]

  @@unique([candidateId, jobId])
  @@index([orgId])
}

model Session {
  id                   String       @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id])
  applicationId        String
  application          Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Pins the kit version the session ran.
  kitId                String
  kit                  Kit          @relation(fields: [kitId], references: [id])
  section              String
  /// ready | live | completed
  status               String       @default("ready")
  interviewer          String
  candidateToken       String       @unique
  presentedQuestionKey String?
  presentedAt          DateTime?
  version              Int          @default(0)
  setNotes             String       @default("")
  recommendation       String?
  createdAt            DateTime     @default(now())
  startedAt            DateTime?
  endedAt              DateTime?
  /// v1: recording consent. Recording segments are accepted only after consentAt is set.
  recordingRequired    Boolean      @default(false)
  consentAt            DateTime?
  consentIp            String?
  consentUserAgent     String?
  consentVersion       String?
  /// v1.1: minutes the interviewer added to the section time limit.
  extensionMinutes     Int          @default(0)
  responses            Response[]
  ratings              Rating[]
  segments             RecordingSegment[]
  events               SessionEvent[]
  marketGames          MarketGame[]

  @@index([orgId, applicationId])
}

model Response {
  id               String   @id @default(cuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionKey      String
  score            Int?
  notes            String   @default("")
  trapNoticed      Boolean  @default(false)
  bonusGiven       Boolean  @default(false)
  skipped          Boolean  @default(false)
  markedForReturn  Boolean  @default(false)
  timeSpentSeconds Int      @default(0)
  updatedAt        DateTime @updatedAt
  /// v1: what the candidate typed in the app.
  candidateAnswer   String?
  candidateAnswerAt DateTime?
  /// v1: first time the question was presented (never reset).
  firstPresentedAt  DateTime?

  @@unique([sessionId, questionKey])
}

model Rating {
  id          String  @id @default(cuid())
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dimensionId Int
  rating      Int?
  note        String  @default("")

  @@unique([sessionId, dimensionId])
}

/// v1: one uploaded media file (camera or screen). `path` is never exposed to clients.
model RecordingSegment {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  sessionId   String
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// camera | screen
  stream      String
  mimeType    String
  /// Absolute file path under RECORDINGS_DIR.
  path        String
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  lastChunkAt DateTime?
  bytes       BigInt       @default(0)
  chunks      Int          @default(0)
  /// Set once ffmpeg has rewritten the file so it is seekable.
  remuxedAt   DateTime?
  /// Set by the retention job once the file is gone. Deleted segments are never served or listed.
  deletedAt   DateTime?

  @@index([sessionId, startedAt])
  @@index([orgId])
}

/// v1: integrity timeline reported by the candidate's browser. Counts, never content.
model SessionEvent {
  id          String    @id @default(cuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String
  /// Server receive time.
  at          DateTime  @default(now())
  clientAt    DateTime?
  /// The question presented when the event was received (server-derived).
  questionKey String?
  detail      String?

  @@index([sessionId, at])
}

/// v1.2: one make-a-market game — a Question.market template instantiated for a session.
/// config, rolls and trueValue are INTERVIEWER ONLY until the game is settled.
model MarketGame {
  id          String        @id @default(cuid())
  sessionId   String
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionKey String
  /// dice | estimate
  kind        String
  /// open | settled
  status      String        @default("open")
  startedAt   DateTime      @default(now())
  settledAt   DateTime?
  /// MarketConfig snapshot taken when the game started.
  config      Json
  /// dice: the values rolled at start, in reveal order.
  rolls       Json?
  trueValue   Float
  revealCount Int           @default(0)
  quotes      MarketQuote[]
  trades      MarketTrade[]

  @@index([sessionId, startedAt])
}

/// v1.2: a two-sided quote the candidate put on the table.
model MarketQuote {
  id           String        @id @default(cuid())
  gameId       String
  game         MarketGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  bid          Float
  ask          Float
  size         Int
  at           DateTime      @default(now())
  /// How many reveals had happened when the quote was made.
  revealsSoFar Int           @default(0)
  trades       MarketTrade[]

  @@index([gameId, at])
}

/// v1.2: the interviewer traded against the candidate quote (buy = lifted the ask, sell = hit the bid).
model MarketTrade {
  id      String       @id @default(cuid())
  gameId  String
  game    MarketGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// The quote that was hit; drives the skew-after-trade metric.
  quoteId String?
  quote   MarketQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// buy | sell (the interviewer side)
  side    String
  price   Float
  size    Int
  at      DateTime     @default(now())

  @@index([gameId, at])
}
