POSTGRES_USER=talent
POSTGRES_PASSWORD=talent
POSTGRES_DB=talent_os
POSTGRES_PORT=5442
API_PORT=4310
UI_PORT=8170

PUBLIC_BASE_URL=https://hiring.basistrading.net
DEFAULT_ORG_SLUG=g20

# Local development only — never set in production (Cloudflare Access supplies identity).
DEV_USER_EMAIL=

# Cloudflare Access JWT verification (optional, defence in depth).
ACCESS_TEAM_DOMAIN=basistradingdotnet.cloudflareaccess.com
ACCESS_AUD=

# Seed file inside the api container (./private/kits is mounted at /kits).
KIT_SEED_PATH=/kits/quant-trader.seed.json

# `cloudflared tunnel token talent-os`
CLOUDFLARE_TUNNEL_TOKEN=
